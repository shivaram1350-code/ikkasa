{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- if customer -%}
  <script>window.location = '{{ routes.account_url }}';</script>
{%- endif -%}

<div class="customer login">
  <div class="login__wrapper page-width page-width--narrow">

    {%- comment -%}
      WhatsApp OTP Login — rendered first, most prominent
    {%- endcomment -%}
    {% render 'otp-login' %}

    {%- comment -%} Divider {%- endcomment -%}
    <div class="ikkasa-divider" role="separator">
      <span>{{ 'customer.login_page.or_email' | t | default: 'Or sign in with email' }}</span>
    </div>

    {%- comment -%}
      Standard Dawn email login form — completely unchanged
    {%- endcomment -%}
    {%- form 'customer_login', class: 'customer__form' -%}
      {%- if form.errors -%}
        <div class="form__message" role="alert">
          <h2
            class="form-status form-status-list form__message caption-large"
            tabindex="-1"
            autofocus
          >
            {%- render 'icon-error' -%}
            {{- 'templates.contact.form.error_heading' | t -}}
          </h2>
          <ul class="form-status-list caption-large">
            {%- for field in form.errors.messages -%}
              <li>{{ field | capitalize }}: {{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="field">
        <input
          class="field__input"
          autocomplete="email"
          type="email"
          id="CustomerEmail"
          name="customer[email]"
          value="{% if form.email %}{{ form.email }}{% endif %}"
          spellcheck="false"
          autocapitalize="off"
          aria-required="true"
          {% if form.errors contains 'form' %}aria-invalid="true"{% endif %}
          placeholder=" "
        >
        <label class="field__label" for="CustomerEmail">
          {{ 'customer.login_page.email' | t }}
        </label>
      </div>

      {%- if shop.checkout.guest_login -%}
        <a href="#recover">{{ 'customer.login_page.forgot_password' | t }}</a>
      {%- endif -%}

      <div class="field">
        <input
          class="field__input"
          autocomplete="current-password"
          type="password"
          id="CustomerPassword"
          name="customer[password]"
          aria-required="true"
          {% if form.errors contains 'form' %}aria-invalid="true"{% endif %}
          placeholder=" "
        >
        <label class="field__label" for="CustomerPassword">
          {{ 'customer.login_page.password' | t }}
        </label>
      </div>

      <div class="customer__links">
        {%- unless shop.checkout.guest_login -%}
          <a href="#recover">{{ 'customer.login_page.forgot_password' | t }}</a>
        {%- endunless -%}
        <button class="button" type="submit">
          {{ 'customer.login_page.sign_in' | t }}
        </button>
      </div>

    {%- endform -%}

    {%- comment -%} Password recovery {%- endcomment -%}
    {%- form 'recover_customer_password', class: 'customer__form hide' -%}
      {%- if form.posted_successfully? -%}
        <div
          class="form__message"
          role="status"
          tabindex="-1"
          autofocus
        >
          <h2 class="form-status caption-large">
            {%- render 'icon-success' -%}
            {{- 'customer.recover_password.success' | t -}}
          </h2>
        </div>
      {%- endif -%}

      <h1 id="RecoverHeading" class="recover-heading">
        {{ 'customer.recover_password.title' | t }}
      </h1>

      <div class="field">
        <input
          class="field__input"
          autocomplete="email"
          type="email"
          id="RecoverEmail"
          name="email"
          spellcheck="false"
          autocapitalize="off"
          placeholder=" "
        >
        <label class="field__label" for="RecoverEmail">
          {{ 'customer.login_page.email' | t }}
        </label>
      </div>

      <div class="customer__links">
        <button class="button" type="submit">
          {{ 'customer.recover_password.submit' | t }}
        </button>
        <a href="#login" id="RecoverCancel">
          {{ 'customer.recover_password.cancel' | t }}
        </a>
      </div>
    {%- endform -%}

    <div class="customer__links">
      <a href="{{ routes.account_register_url }}">
        {{ 'customer.login_page.create_account' | t }}
      </a>
    </div>

  </div>
</div>

<style>
/* ── "Or sign in with email" divider ── */
.ikkasa-divider {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 0 0 24px;
  color: rgba(var(--color-foreground), .45);
  font-size: calc(var(--font-body-scale) * 1.3rem);
}
.ikkasa-divider::before,
.ikkasa-divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: rgba(var(--color-foreground), .1);
}
</style>

{% schema %}
{
  "name": "Login",
  "settings": []
}
{% endschema %}
